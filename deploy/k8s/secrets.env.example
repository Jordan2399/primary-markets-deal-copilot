# Copy to deploy/k8s/secrets.env (git-ignored) and fill in real values.
# The deploy script turns this file into the Kubernetes Secret "dealcopilot-secrets".
# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NEO4J_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=change-me-at-least-32-characters-long-random-string
# Password for the sample users created by the seed job. Leave empty to use the built-in default.
DEMO_USER_PASSWORD=
