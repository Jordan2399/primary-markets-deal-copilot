# Copy to .env.dev (git-ignored) and adjust. Development values only.
APP_ENV=development
LOG_LEVEL=DEBUG

NEO4J_PASSWORD=change-me-dev-only

# Ollama runs natively on the host (Windows). Containers reach it through host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_CHAT_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text
# Seconds to wait for the model; a 7B model on CPU needs more than the default 120.
LLM_TIMEOUT_SECONDS=300
# gaps = rules first, model only for missing fields; always = model reads every document.
TERMSHEET_MODEL_MODE=gaps

CORS_ORIGINS=http://localhost:3000

# Sign-in. The seed creates the demo users with this password (development only).
# Leave empty to use the documented default from the README.
AUTH_MODE=jwt
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-0000
DEMO_USER_PASSWORD=
