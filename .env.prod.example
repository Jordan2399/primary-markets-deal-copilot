# Copy to .env.prod (git-ignored). Use a strong, unique Neo4j password and never reuse the dev one.
APP_ENV=production
LOG_LEVEL=INFO

NEO4J_PASSWORD=use-a-long-random-password-here

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_CHAT_MODEL=qwen2.5:7b-instruct
LLM_EMBED_MODEL=nomic-embed-text

CORS_ORIGINS=http://localhost:3100

# Must be a long random value, different from development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-value-from-the-command-above
# Set to true when the site is served over HTTPS (the session cookie is then marked Secure).
COOKIE_SECURE=false
